<?xml version="1.0" encoding="utf-8"?>
<!-- 截图确认弹窗：复刻 PC 端结构，套用 App 暖棕琥珀配色。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/screen_capture_card_bg"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◆ Obsidian Vow"
            android:textColor="#75695d"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#3b332b" />

        <TextView
            android:id="@+id/tvCaptureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="AI 请求查看你的屏幕"
            android:textColor="#f3e7d5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCaptureReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="原因："
            android:textColor="#b5a898"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvCaptureTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="⏱ 30s"
            android:textColor="#b5a898"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/btnCaptureAllow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/screen_capture_btn_allow"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="允许查看"
                android:textColor="#1a1714"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCaptureDeny"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/screen_capture_btn_deny"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="拒绝"
                android:textColor="#c9bba8"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
