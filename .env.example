# Obsidian Vow 环境变量示例。复制此文件为 .env 后填入真实 key。
# 注意：.env 已在 .gitignore 中，不会被 git 跟踪。
# 环境变量优先级高于 data/settings.json —— 两处都设置时以 env 为准。

# ── 部署相关 ──────────────────────────────────────
# 服务器监听地址：本机/Docker 内默认 0.0.0.0；如果直接裸跑想只允许本机访问可改 127.0.0.1
AION_BIND_HOST=0.0.0.0
AION_BIND_PORT=18080

# 鉴权 Token：留空则完全不校验（仅本机/局域网测试用）。
# 公网/Tailscale 部署务必填一个长随机串（>=32 字符），例如:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# APK 端在设置里填同一个 token；浏览器首次访问 https://your-host/chat?token=<TOKEN>
# 即可自动写 cookie，之后不再需要带 token 参数。
AION_AUTH_TOKEN=

# ── 预设渠道 ──────────────────────────────────────
AION_GEMINI_KEY=
AION_GEMINI_FREE_KEY=
AION_SILICONFLOW_KEY=
AION_AIPRO_KEY=
AION_NETEASE_MUSIC_U=

# ── 网络代理（可选；留空即直连）────────────────────
AION_PROVIDER_PROXY=
AION_GEMINI_PROXY=
AION_OPENAI_PROXY=
AION_WEB_PUSH_PROXY=

# ── 自定义端点（可选） ────────────────────────────
# 命名规则：AION_ENDPOINT_{端点ID大写}_KEY
# 例如 settings.json 里端点 id = "deepseek"，对应：
# AION_ENDPOINT_DEEPSEEK_KEY=sk-xxx
